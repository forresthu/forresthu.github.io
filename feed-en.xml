---
layout: null
permalink: /feed-en.xml
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.title }} (English)</title>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/feed-en.xml" rel="self" type="application/rss+xml" />
    <description>English posts from {{ site.title }}.</description>
    <language>en</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% assign en_posts = site.posts | where: "lang", "en" %}
    {% for post in en_posts limit:20 %}
      {% if post.description %}
        {% assign summary = post.description %}
      {% else %}
        {% assign paragraphs = post.content | split: '<p>' %}
        {% assign body_size = paragraphs | size | minus: 1 %}
        {% assign summary = paragraphs | slice: 1, body_size | join: ' ' | replace: '</', ' </' | strip_html | strip_newlines | replace: "  ", " " | strip | truncate: 300 %}
      {% endif %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <link>{{ post.url | absolute_url }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <description>{{ summary | xml_escape }}</description>
        {% if post.image %}<enclosure url="{{ post.image | absolute_url }}" type="image/png" length="0" />{% endif %}
        {% for tag in post.tags %}<category>{{ tag | xml_escape }}</category>{% endfor %}
      </item>
    {% endfor %}
  </channel>
</rss>
